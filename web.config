<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / iisnode config for hosting ICE Pulse (Next.js) on Plesk for Windows.
  Routes EVERY request to the Next.js server (app.js) so Next serves pages, the
  /api routes, AND the static assets (/_next/static, /public) — IIS must not try
  to serve those from disk because their URLs don't map to physical file paths.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="ICEPulseAll" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Let the Node app's own error responses through unchanged. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
