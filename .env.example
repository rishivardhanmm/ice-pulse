# =====================================================================
# ICE Pulse — environment variables (TEMPLATE)
# ---------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is gitignored — NEVER put real secrets in THIS file.
# =====================================================================

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=ICE Pulse
APP_URL=http://localhost:3000

# ── MSSQL ────────────────────────────────────────────────────────────
# MSSQL_AUTH=windows  -> Windows Integrated Security (uses the msnodesqlv8 driver)
# MSSQL_AUTH=sql      -> SQL login with username/password (uses the tedious driver)
#
# Dev machine vs. hosted server: put the values below in .env.local for the
# hosted/shared DB (used by production and as the default fallback). To point
# your own machine's `npm run dev` at a local SQL Server Express instance
# instead, add MSSQL_* overrides to .env.development.local (gitignored,
# dev-only, never deployed) — Next.js and the CLI scripts (scripts/_env.ts)
# both load it before .env.local, so it wins locally without touching the
# hosted config. Example dev-only override:
#   MSSQL_AUTH=windows
#   MSSQL_SERVER=localhost
#   MSSQL_INSTANCE=SQLEXPRESS
#   MSSQL_ENCRYPT=false
MSSQL_AUTH=sql
MSSQL_SERVER=176.74.16.213
# Hosted/fixed-port SQL Server: leave MSSQL_INSTANCE blank and use MSSQL_PORT.
# Local/named instance only: set MSSQL_INSTANCE (e.g. SQLEXPRESS) and ensure SQL Browser is running.
MSSQL_INSTANCE=
MSSQL_PORT=1433
MSSQL_DATABASE=IcePulse
# Only used when MSSQL_AUTH=sql. Put the real password in .env.local or hosting secrets.
MSSQL_USER=IcePulse
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_CONNECTION_TIMEOUT_MS=30000
# 0 disables request timeout. Use 60000 locally if you prefer a cap.
MSSQL_REQUEST_TIMEOUT_MS=0
MSSQL_APP_NAME=ICE Pulse

# ── Google Ads API ───────────────────────────────────────────────────
# GOOGLE_ADS_AUTH=oauth            -> OAuth refresh-token flow (works on any account)
# GOOGLE_ADS_AUTH=service_account  -> service account + Workspace domain-wide delegation
GOOGLE_ADS_AUTH=oauth

# Required for BOTH modes (customer ids are digits only, no dashes):
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CUSTOMER_ID=your_customer_id
GOOGLE_ADS_LOGIN_CUSTOMER_ID=        # only if under a manager (MCC) account
GOOGLE_ADS_API_VERSION=v24

# --- OAuth mode ---
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token

# --- Service-account mode ---
# Two ways to supply the downloaded service-account JSON key (contains client_email +
# private_key) — set ONE of these:
#
# Recommended for hosting (Plesk/IIS): paste the whole key file as base64 into a single
# env var, the same way every other secret here works — no filesystem/permissions to
# manage. Generate the value locally with:
#   node -e "console.log(require('fs').readFileSync('key.json').toString('base64'))"
GOOGLE_ADS_SERVICE_ACCOUNT_KEY_BASE64=
#
# Convenient for local dev: a path to the key file on disk instead. Ignored if
# GOOGLE_ADS_SERVICE_ACCOUNT_KEY_BASE64 is set.
GOOGLE_ADS_SERVICE_ACCOUNT_KEY_FILE=
#
# Workspace user (with Google Ads access) to impersonate — optional either way.
GOOGLE_ADS_IMPERSONATION_EMAIL=

# ── Meta Ads (Facebook / Instagram) ─────────────────────────────────
# How to get these:
# 1. META_ACCESS_TOKEN: In Meta Business Suite → Settings → Users → System Users,
#    create a System User (Admin), assign your Ad Account, generate a token with
#    "ads_read" permission set to "Never expire".
# 2. META_AD_ACCOUNT_ID: In Meta Business Suite → Ad Accounts (format: act_XXXXXXXXX).
# 3. META_APP_ID: Your App ID from the Meta App Dashboard (your Configuration ID).
# 4. META_APP_SECRET: App Dashboard → Settings → Basic → App Secret.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v22.0

# ── AI (OpenAI gpt-4o-mini; provider-agnostic) ───────────────────────
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# OpenAI direct: leave default. Azure AI Foundry: https://<resource>.services.ai.azure.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Pricing used to estimate cost (USD per 1M tokens). gpt-4o-mini defaults shown.
AI_INPUT_PRICE_PER_1M=0.15
AI_OUTPUT_PRICE_PER_1M=0.60
AI_MAX_OUTPUT_TOKENS=500
# Max attempts for the text-to-SQL chat to self-correct a failed/insufficient query.
AI_SQL_MAX_ATTEMPTS=3

# ── Canva Connect (Public draft integration — internal only) ─────────
# Create a PUBLIC integration in DRAFT/testing mode in the Canva developer
# portal. Do NOT submit for public review. See docs/canva-integration.md.
CANVA_CLIENT_ID=your_canva_client_id
CANVA_CLIENT_SECRET=your_canva_client_secret
# Must EXACTLY match a redirect URL registered in the portal. Canva allows http
# only for 127.0.0.1 in local dev (not localhost).
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/canva/callback
# Space-separated scopes (request the minimum you need; list read+write pairs).
# Only request scopes you have ENABLED in the Canva portal (else "invalid scope").
# asset:write is omitted until asset upload is built — enable the asset Write box
# in the portal and add it here at that point.
CANVA_SCOPES=profile:read design:meta:read design:content:read brandtemplate:meta:read asset:read
CANVA_API_BASE_URL=https://api.canva.com/rest/v1
CANVA_OAUTH_AUTHORIZE_URL=https://www.canva.com/api/oauth/authorize
CANVA_OAUTH_TOKEN_URL=https://api.canva.com/rest/v1/oauth/token
# 32+ char random key to encrypt OAuth tokens at rest (AES-256-GCM). Set before real use.
CANVA_TOKEN_ENCRYPTION_KEY=

# ── Zoho Social ──────────────────────────────────────────────────────
# 1. Go to https://api-console.zoho.com → "Add Client" → "Server-based Applications"
#    Register ICE Pulse with redirect URI: http://localhost:3000/api/zoho-social/callback
#    For production: https://yourdomain.com/api/zoho-social/callback
# 2. Copy Client ID and Client Secret below.
# 3. Find your Org ID in the Zoho Social URL: https://social.zoho.com.au/org/{ID}/
# 4. Click "Connect Zoho Social" in the app to complete OAuth and start syncing.
ZOHO_SOCIAL_CLIENT_ID=
ZOHO_SOCIAL_CLIENT_SECRET=
ZOHO_SOCIAL_ORG_ID=
# Data center: 'com.au' (Australia/default) | 'com' (Global) | 'eu' | 'in'
ZOHO_SOCIAL_DC=com.au
# Redirect URI (must match exactly what's registered in Zoho API Console)
ZOHO_SOCIAL_REDIRECT_URI=http://localhost:3000/api/zoho-social/callback
# 32+ char key for AES-256-GCM token encryption at rest
ZOHO_SOCIAL_TOKEN_ENCRYPTION_KEY=

# ── GNews (live news feed for News Insights) ─────────────────────────
# Free key from gnews.io — 100 requests/day, no production restriction.
# Register at: https://gnews.io/register (no credit card required)
GNEWS_API_KEY=

# ── SendGrid (email notifications) ────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@icecreates.com
SENDGRID_FROM_NAME=ICE Pulse
# TESTING ONLY: redirects every outgoing email to this address regardless of the real
# recipient. Leave blank in production so real users get their own notifications.
EMAIL_OVERRIDE_TO=


