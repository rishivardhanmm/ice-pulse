# Deploy credentials — copy to .env.deploy and fill in real values.
# .env.deploy is git-ignored and must never be committed.

# Server connection
DEPLOY_HOST=176.74.16.213
DEPLOY_PORT=22
DEPLOY_USER=rishi
DEPLOY_PASSWORD=your-sftp-password

# SFTP path — exactly what FileZilla shows in "Remote site:" (chrooted, forward slashes)
DEPLOY_SFTP_PATH=/httpdocs

# Real Windows filesystem path — used for remote shell commands (Expand-Archive, npm ci, app.js touch)
# Find it by opening Plesk > Hosting > File Manager and checking the address bar, or SSH in and run: echo %CD%
# Typical Plesk Windows pattern: C:\inetpub\vhosts\<domain>\httpdocs
DEPLOY_WIN_PATH=C:\inetpub\vhosts\pulse.icecreates.com\httpdocs

# Set to true only when package.json changes (runs npm ci on server — slow).
# Leave false for code-only deploys.
DEPLOY_INSTALL_DEPS=false
